# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hrms

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
# Public URL of this API (auto-detected on Render)
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Email ---
# Local dev prints emails to the console. For production use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Resend:  host smtp.resend.com, user "resend", password = API key
# Gmail:   host smtp.gmail.com, user = your address, password = app password
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HRMS <no-reply@yourdomain.com>

# --- Media (logo uploads) ---
# cloudinary://<api_key>:<api_secret>@<cloud_name>  (leave empty to use local disk in dev)
CLOUDINARY_URL=
